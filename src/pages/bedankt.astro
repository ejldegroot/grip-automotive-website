---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Bedankt — Grip Automotive"
  description="Je demo-aanvraag is ontvangen. We nemen binnen één werkdag contact met je op."
>
  <section class="hero" style="padding-bottom:88px;">
    <div class="wrap center">
      <p class="kicker">Aanvraag ontvangen</p>
      <h1>Bedankt — we nemen snel contact op</h1>
      <p class="lead" style="margin-left:auto; margin-right:auto;">
        Je demo-aanvraag is binnen. Binnen één werkdag hoor je van ons om een moment te plannen.
        Kijk gerust alvast verder bij <a href="/product/">het product</a>.
      </p>
      <a href="/" class="btn btn-ghost mt-2">Terug naar home</a>
    </div>
  </section>
</Layout>
